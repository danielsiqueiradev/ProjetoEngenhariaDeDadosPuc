{
  "datasets": [
    {
      "name": "2e962a61",
      "displayName": "Top Brazilian Movies Ranked by Audience and IMDb Ratings",
      "queryLines": [
        "USE CATALOG `dbacademy`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    titulo_brasil,\n",
        "    MAX(nota_imdb) AS nota_imdb,\n",
        "    SUM(publico) AS total_publico\n",
        "FROM dbacademy.default.gold_features_bilheteria\n",
        "WHERE nota_imdb IS NOT NULL AND nota_imdb > 0\n",
        "GROUP BY titulo_brasil\n",
        "ORDER BY total_publico DESC\n",
        "LIMIT 100;"
      ]
    }
  ],
