{
  "datasets": [
    {
      "name": "bc728cd5",
      "displayName": "Regional Ticket Sales and Income Estimates Summary",
      "queryLines": [
        "USE CATALOG `dbacademy`;\n",
        "\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "  uf,\n",
        "  SUM(publico) AS total_publico,\n",
        "  SUM(publico) * 20 AS `estimativa_renda_r$`\n",
        "FROM\n",
        "  dbacademy.default.gold_features_bilheteria\n",
        "GROUP BY\n",
        "  uf\n",
        "ORDER BY\n",
        "  total_publico DESC\n",
        "LIMIT 10;"
      ],
      "columns": [
        {
          "displayName": "percentual_publico",
          "expression": "SUM(`total_publico`) * 100.0 / SUM(SUM(`total_publico`)) OVER ()"
        }
      ]
    }
  ],
