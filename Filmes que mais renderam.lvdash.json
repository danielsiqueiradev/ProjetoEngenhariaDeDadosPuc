{
  "datasets": [
    {
      "name": "0d9c4d11",
      "displayName": "Top Brazilian Movie Earnings and Audience Insights",
      "queryLines": [
        "USE CATALOG `dbacademy`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    titulo_brasil,\n",
        "    SUM(publico) AS total_publico,\n",
        "    SUM(publico) * 20 AS `estimativa_renda_r$`\n",
        "FROM dbacademy.default.gold_features_bilheteria\n",
        "GROUP BY titulo_brasil\n",
        "ORDER BY `estimativa_renda_r$` DESC\n",
        "LIMIT 10;"
      ]
    }
  ],
