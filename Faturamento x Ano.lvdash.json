{
  "datasets": [
    {
      "name": "8f5de767",
      "displayName": "Annual Movie Attendance and Revenue Estimates",
      "queryLines": [
        "USE CATALOG `dbacademy`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    ano_exibicao,\n",
        "    SUM(publico) AS total_publico,\n",
        "    SUM(publico) * 20 AS `faturamento_estimado_r$`\n",
        "FROM dbacademy.default.gold_features_bilheteria\n",
        "WHERE ano_exibicao BETWEEN 2021 AND 2025\n",
        "GROUP BY ano_exibicao\n",
        "ORDER BY ano_exibicao ASC;"
      ]
    }
  ],
